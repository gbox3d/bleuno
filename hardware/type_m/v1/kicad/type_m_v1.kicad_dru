(version 1)

# Imported from validation/easyeda-baseline.json, copperThickness1oz.
# Boardwide object-type rules. No net, position, reference or violation exceptions.
# General rules precede specific rules because KiCad evaluates rules in reverse.

(rule "EasyEDA ordinary copper clearance"
  (constraint clearance (min 0.15200122mm)))

(rule "EasyEDA track to track clearance"
  (condition "A.Type == 'Track' && B.Type == 'Track'")
  (constraint clearance (min 0.10199878mm)))

(rule "EasyEDA copper zone clearance"
  (condition "A.Type == 'Zone' || B.Type == 'Zone'")
  (constraint clearance (min 0.254mm)))

(rule "EasyEDA copper to board outline"
  (constraint edge_clearance (min 0.29999939999999997mm)))

(rule "EasyEDA zone to board outline"
  (condition "A.Type == 'Zone'")
  (constraint edge_clearance (min 0.254mm)))

(rule "EasyEDA copper to drilled hole"
  (constraint hole_clearance (min 0.17526mm)))

(rule "EasyEDA zone to drilled hole"
  (condition "A.Type == 'Zone' || B.Type == 'Zone'")
  (constraint hole_clearance (min 0.254mm)))

(rule "EasyEDA drilled hole to hole"
  (constraint hole_to_hole (min 0.29999939999999997mm)))

(rule "EasyEDA track width"
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.127mm) (opt 0.254mm) (max 2.54mm)))
